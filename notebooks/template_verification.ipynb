{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🌵 Drought Forecast Verification — Template Notebook\n",
    "\n",
    "This notebook demonstrates the full `drought-forecast-eval` workflow:\n",
    "\n",
    "1. **Download** (optional) fresh data from BGDI\n",
    "2. **Load** forecast archive and observation archive\n",
    "3. **Align** observations to the forecast grid\n",
    "4. **Build** a reference forecast (climatology or persistence)\n",
    "5. **Compute** verification scores\n",
    "6. **Visualise** skill curves and regional maps\n",
    "7. **Export** results (NetCDF, CSV, HTML report)\n",
    "\n",
    "Copy this notebook and adapt the paths / settings for your specific experiment.\n",
    "\n",
    "---\n",
    "**Docs:** `docs/` | **Source:** `drought_forecast_eval/` | **Issues / MRs:** GitLab repo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "# ── EDIT THESE PATHS ──────────────────────────────────────────────────────\n",
    "ARCHIVE_DIR   = Path(\"data/zipfiles\")               # flat dir of daily ZIPs\n",
    "HISTORIC_ZIP  = Path(\"/data/historic.csv.zip\")      # full observation archive\n",
    "SHAPEFILE     = None  # Path('/path/to/BAFU_Grossregionen_v3_reproj.shp')\n",
    "OUTPUT_DIR    = Path(\"./output\")\n",
    "\n",
    "DATE_RANGE    = (\"2025-01-01\", \"2025-12-31\")        # verification window\n",
    "REGIONS       = \"all\"                                # or e.g. [1, 5, 12, 31]\n",
    "VARIABLES     = \"all\"                                # or e.g. [\"spi_1m\", \"cdi\"]\n",
    "CDI_THRESHOLD = 2                                    # CDI ≥ threshold = drought event\n",
    "# ──────────────────────────────────────────────────────────────────────────"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. (Optional) Download fresh data from BGDI"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from drought_forecast_eval.io.downloader import download_archive, download_historic\n",
    "\n",
    "# Uncomment to download:\n",
    "# download_archive(ARCHIVE_DIR, start=DATE_RANGE[0], end=DATE_RANGE[1])\n",
    "# download_historic(HISTORIC_ZIP)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from drought_forecast_eval import load_forecasts, load_observations\n",
    "\n",
    "region_ids = None if REGIONS == \"all\" else REGIONS\n",
    "\n",
    "ds_fcst = load_forecasts(ARCHIVE_DIR, date_range=DATE_RANGE, region_ids=region_ids)\n",
    "ds_obs  = load_observations(HISTORIC_ZIP, region_ids=region_ids)\n",
    "\n",
    "print(\"Forecast dataset:\")\n",
    "print(ds_fcst)\n",
    "print(\"\\nObservation dataset:\")\n",
    "print(ds_obs)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Align observations to the forecast grid"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from drought_forecast_eval import align_obs_to_forecast\n",
    "\n",
    "ds_merged = align_obs_to_forecast(ds_fcst, ds_obs)\n",
    "print(\"Merged dataset dims:\", dict(ds_merged.dims))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Build reference forecast\n",
    "\n",
    "Choose `\"climatology\"`, `\"persistence\"`, or `\"both"`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from drought_forecast_eval import climatology_reference, persistence_reference\n",
    "\n",
    "# --- Climatology (week-of-year ± 4 weeks) ---\n",
    "ds_ref_clim = climatology_reference(ds_obs, ds_fcst, week_window=4)\n",
    "\n",
    "# --- Persistence (last observed value before each FRT) ---\n",
    "ds_ref_pers = persistence_reference(ds_obs, ds_fcst)\n",
    "\n",
    "print(\"Climatology reference variables:\", list(ds_ref_clim.data_vars)[:5], \"...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Compute scores"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from drought_forecast_eval import compute_scores\n",
    "\n",
    "ds_scores = compute_scores(\n",
    "    ds_merged,\n",
    "    variables=VARIABLES,\n",
    "    scores=\"default\",\n",
    "    ds_ref=ds_ref_clim,\n",
    "    cdi_threshold=CDI_THRESHOLD,\n",
    ")\n",
    "\n",
    "print(\"Score variables:\", list(ds_scores.data_vars))\n",
    "ds_scores"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5a. Add custom metrics\n",
    "You can register your own scoring function and include it by name:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import xarray as xr\n",
    "from drought_forecast_eval import register_score\n",
    "\n",
    "def my_custom_score(fcst: xr.DataArray, obs: xr.DataArray, **kwargs) -> xr.DataArray:\n",
    "    \"\"\"Example: mean signed error.\"\"\"\n",
    "    return (fcst - obs).mean(dim=kwargs.get(\"reduce_dims\", []))\n",
    "\n",
    "register_score(\"signed_error\", my_custom_score)\n",
    "\n",
    "ds_scores_custom = compute_scores(\n",
    "    ds_merged,\n",
    "    variables=[\"spi_1m\", \"cdi\"],\n",
    "    scores=[\"mae\", \"signed_error\"],\n",
    ")\n",
    "ds_scores_custom"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Visualise results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "from drought_forecast_eval.visualization import plot_skill_vs_lead\n",
    "\n",
    "fig = plot_skill_vs_lead(\n",
    "    ds_scores,\n",
    "    variables=[\"spi_1m\", \"spi_6m\", \"spi_24m\", \"cdi\"],\n",
    "    score=\"mae\",\n",
    "    title=\"MAE by lead week\",\n",
    ")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# RPSS (requires reference forecast)\n",
    "ds_scores_with_rpss = compute_scores(\n",
    "    ds_merged,\n",
    "    variables=[\"spi_1m\", \"spi_6m\", \"precip_sum_1m\"],\n",
    "    scores=[\"rpss\"],\n",
    "    ds_ref=ds_ref_clim,\n",
    ")\n",
    "\n",
    "fig2 = plot_skill_vs_lead(\n",
    "    ds_scores_with_rpss,\n",
    "    variables=[\"spi_1m\", \"spi_6m\", \"precip_sum_1m\"],\n",
    "    score=\"rpss\",\n",
    "    zero_line=True,\n",
    "    title=\"RPSS vs climatology reference\",\n",
    ")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Regional map (requires shapefile; falls back to bar chart if not provided)\n",
    "from drought_forecast_eval.visualization import plot_region_map\n",
    "\n",
    "fig3 = plot_region_map(\n",
    "    ds_scores,\n",
    "    score_variable=\"spi_1m_mae\",\n",
    "    shapefile_path=SHAPEFILE,\n",
    "    lead_weeks=[0, 1, 2, 3],\n",
    "    cmap=\"RdYlGn_r\",\n",
    ")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Experiment comparison: period A vs period B\n",
    "from drought_forecast_eval.visualization import plot_experiment_diff\n",
    "\n",
    "# Example: compare first half vs second half of the year\n",
    "DATE_RANGE_A = (\"2025-01-01\", \"2025-06-30\")\n",
    "DATE_RANGE_B = (\"2025-07-01\", \"2025-12-31\")\n",
    "\n",
    "ds_fcst_a = load_forecasts(ARCHIVE_DIR, date_range=DATE_RANGE_A, region_ids=region_ids)\n",
    "ds_fcst_b = load_forecasts(ARCHIVE_DIR, date_range=DATE_RANGE_B, region_ids=region_ids)\n",
    "\n",
    "ds_merged_a = align_obs_to_forecast(ds_fcst_a, ds_obs)\n",
    "ds_merged_b = align_obs_to_forecast(ds_fcst_b, ds_obs)\n",
    "\n",
    "ds_ref_a = climatology_reference(ds_obs, ds_fcst_a)\n",
    "ds_ref_b = climatology_reference(ds_obs, ds_fcst_b)\n",
    "\n",
    "ds_scores_a = compute_scores(ds_merged_a, variables=[\"spi_1m\", \"cdi\"], scores=[\"mae\"], ds_ref=ds_ref_a)\n",
    "ds_scores_b = compute_scores(ds_merged_b, variables=[\"spi_1m\", \"cdi\"], scores=[\"mae\"], ds_ref=ds_ref_b)\n",
    "\n",
    "fig4 = plot_experiment_diff(\n",
    "    ds_scores_a, ds_scores_b,\n",
    "    variables=[\"spi_1m\", \"cdi\"],\n",
    "    score=\"mae\",\n",
    "    label_a=\"H1 2025\",\n",
    "    label_b=\"H2 2025\",\n",
    ")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Export results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from drought_forecast_eval import ReportBuilder\n",
    "\n",
    "builder = ReportBuilder(\n",
    "    archive_dir=ARCHIVE_DIR,\n",
    "    historic_path=HISTORIC_ZIP,\n",
    "    date_range=DATE_RANGE,\n",
    "    regions=REGIONS,\n",
    "    variables=VARIABLES,\n",
    "    scores=\"default\",\n",
    "    reference=\"climatology\",\n",
    "    cdi_threshold=CDI_THRESHOLD,\n",
    "    shapefile_path=SHAPEFILE,\n",
    "    output_dir=OUTPUT_DIR,\n",
    ")\n",
    "\n",
    "# Run the full pipeline and write all outputs\n",
    "outputs = builder.run()\n",
    "print(\"Outputs:\")\n",
    "for key, path in outputs.items():\n",
    "    print(f\"  {key}: {path}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
