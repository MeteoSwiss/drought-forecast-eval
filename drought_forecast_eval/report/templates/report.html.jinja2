<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Drought Forecast Verification Report</title>
  <style>
    body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
           margin: 0; padding: 0; background: #f8f9fa; color: #212529; }
    .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { color: #003865; border-bottom: 3px solid #0070b8; padding-bottom: .4rem; }
    h2 { color: #0070b8; margin-top: 2.5rem; }
    h3 { color: #444; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .9rem; }
    th { background: #0070b8; color: white; padding: .5rem .8rem; text-align: left; }
    td { padding: .4rem .8rem; border-bottom: 1px solid #dee2e6; }
    tr:nth-child(even) td { background: #e9f2fa; }
    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .meta-box { background: white; border-radius: 6px; padding: 1rem 1.2rem;
                box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .meta-box dt { font-weight: bold; color: #555; font-size: .85rem; }
    .meta-box dd { margin: .1rem 0 .6rem 0; font-size: .95rem; }
    .plot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 1.5rem 0; }
    .plot-card { background: white; border-radius: 6px; padding: .8rem;
                 box-shadow: 0 1px 4px rgba(0,0,0,.08); text-align: center; }
    .plot-card img { max-width: 100%; height: auto; }
    .plot-card .caption { font-size: .82rem; color: #666; margin-top: .4rem; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: 3px;
             font-size: .78rem; font-weight: bold; }
    .badge-green { background: #d4edda; color: #155724; }
    .badge-orange { background: #fff3cd; color: #856404; }
    .badge-red { background: #f8d7da; color: #721c24; }
    footer { margin-top: 3rem; font-size: .8rem; color: #888;
             border-top: 1px solid #dee2e6; padding-top: 1rem; }
    @media print { body { background: white; } }
  </style>
</head>
<body>
<div class="container">

  <h1>🌵 Drought Forecast Verification Report</h1>

  <!-- ── Metadata ── -->
  <div class="meta-grid">
    <div class="meta-box">
      <dl>
        <dt>Verification period</dt>
        <dd>{{ meta.date_range[0] }} → {{ meta.date_range[1] }}</dd>
        <dt>Regions</dt>
        <dd>{{ meta.n_regions }} region(s)
            {% if meta.regions != "all" %}({{ meta.regions | join(", ") }}){% endif %}
        </dd>
        <dt>Reference forecast</dt>
        <dd>{{ meta.reference_type }}</dd>
        <dt>CDI drought threshold</dt>
        <dd>≥ {{ meta.cdi_threshold }}</dd>
      </dl>
    </div>
    <div class="meta-box">
      <dl>
        <dt>Variables scored</dt>
        <dd>{{ meta.variables | join(", ") }}</dd>
        <dt>Metrics computed</dt>
        <dd>{{ meta.scores | join(", ") }}</dd>
        <dt>Generated</dt>
        <dd>{{ meta.generated_at }}</dd>
        <dt>Library version</dt>
        <dd>{{ meta.library_version }}</dd>
      </dl>
    </div>
  </div>

  <!-- ── Summary statistics table ── -->
  <h2>Summary Statistics</h2>
  {% if summary_table %}
  <table>
    <thead>
      <tr>
        <th>Variable</th>
        <th>Metric</th>
        {% for lw in lead_weeks %}<th>Week {{ lw }}</th>{% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in summary_table %}
      <tr>
        <td>{{ row.variable }}</td>
        <td>{{ row.metric }}</td>
        {% for val in row['values'] %}
        <td>
          {% if val is not none %}
            {{ "%.3f" | format(val) }}
          {% else %}
            —
          {% endif %}
        </td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p><em>No summary statistics available.</em></p>
  {% endif %}

  <!-- ── Skill curves ── -->
  {% if plots.skill_curves %}
  <h2>Skill Score vs Lead Time</h2>
  <div class="plot-grid">
    {% for item in plots.skill_curves %}
    <div class="plot-card">
      <img src="{{ item.path }}" alt="{{ item.caption }}" />
      <div class="caption">{{ item.caption }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ── Regional maps ── -->
  {% if plots.region_maps %}
  <h2>Regional Performance Maps</h2>
  <div class="plot-grid">
    {% for item in plots.region_maps %}
    <div class="plot-card">
      <img src="{{ item.path }}" alt="{{ item.caption }}" />
      <div class="caption">{{ item.caption }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ── Experiment comparison ── -->
  {% if plots.comparisons %}
  <h2>Experiment Comparisons</h2>
  <div class="plot-grid">
    {% for item in plots.comparisons %}
    <div class="plot-card">
      <img src="{{ item.path }}" alt="{{ item.caption }}" />
      <div class="caption">{{ item.caption }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <footer>
    Generated by <strong>drought-forecast-eval {{ meta.library_version }}</strong> ·
    Data source: <a href="https://trockenheit.admin.ch">trockenheit.admin.ch</a> /
    <a href="https://data.geo.admin.ch">BGDI</a> ·
    Methodology: see <code>docs/methodology.md</code>
  </footer>

</div>
</body>
</html>
